main" name="Transaction" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="52"/><column index="2" value="91"/><column index="3" value="31"/><column index="4" value="79"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Transaction_Items" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="52"/><column index="2" value="47"/><column index="3" value="51"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE &quot;Transaction&quot; (
	&quot;order_id&quot; INTEGER, 
	&quot;customer_name&quot; TEXT REFERENCES &quot;Customer&quot;(&quot;customer_name&quot;) ON DELETE
											 CASCADE ON UPDATE CASCADE, 
	&quot;date&quot; DATE,
	&quot;total_payable&quot; REAL, 
	PRIMARY KEY(&quot;order_id&quot;)
);
</sql><sql name="SQL 2">CREATE TABLE &quot;Transaction_Items&quot; (	
	&quot;order_id&quot; INTEGER, 
	&quot;item_id&quot; INTEGER,
	&quot;quantity&quot; INTEGER,
	PRIMARY KEY(&quot;order_id&quot;, &quot;item_id&quot;)
); 

</sql><current_tab id="0"/></tab_sql></sqlb_project>
